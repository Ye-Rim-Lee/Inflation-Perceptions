  number = {1},
  pages = {nbae034},
  issn = {1479-8409, 1479-8417},
  doi = {10.1093/jjfinec/nbae034},
  urldate = {2025-12-10},
  abstract = {We empirically characterize the heterogeneity in the conditional distribution of household inflation expectations across demographic groups using the Survey of Consumer Expectations and also investigate how monetary policy shocks affect the conditional distribution. We find that, across all the groups, the peak of the group-specific distribution of household inflation expectations aligns closely with the 2\% target set by the Federal Reserve, but there is substantial heterogeneity both within and across groups, primarily on the right. However, in response to a contractionary monetary policy shock identified by high-frequency financial market responses, households overall adjust their inflation expectations significantly downwards. In addition, the magnitude of the reaction is more pronounced in the upper quantile of low income groups whose unconditional inflation expectations are less well anchored.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  file = {/Users/YerimLee/Zotero/storage/5TYJIUGJ/Doh et al. - 2025 - Heterogeneity in Household Inflation Expectations and Monetary Policy.pdf}
}

