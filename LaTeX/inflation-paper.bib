@article{may_widespread_2009,
	title = {Widespread {Policy} {Disruption}: {Terrorism}, {Public} {Risks}, and {Homeland} {Security}},
	volume = {37},
	copyright = {© 2009 Policy Studies Organization},
	issn = {1541-0072},
	shorttitle = {Widespread {Policy} {Disruption}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/j.1541-0072.2009.00309.x},
	doi = {10.1111/j.1541-0072.2009.00309.x},
	abstract = {We address theoretical and empirical aspects of policy disruptions that affect multiple areas of policymaking. Our theorizing leads us to consider the effects of widespread disruptions in gaining the attention of elected officials, in affecting policymaking, and in reshaping the involvement of federal agencies. Our empirical analyses concern the threat of terrorism in the United States and its implications for public risk subsystems over the past 25 years. Our analyses of the attention of policymakers and resultant policymaking volatility show selective patterns of subsystem disruption related to the threat of terrorism. We show that capturing the attention of policymakers in multiple subsystems is insufficient to motivate heightened levels of policymaking across the board. In addition, we find more muted impacts for federal agency involvement than might have been expected from the massive reorganization that created the Department of Homeland Security. More generally, the disjunctions we observe show the powerful influence of policy subsystems in buffering against widespread policy disruptions.},
	language = {en},
	number = {2},
	urldate = {2019-12-06},
	journal = {Policy Studies Journal},
	author = {May, Peter J. and Sapotichne, Joshua and Workman, Samuel},
	year = {2009},
	keywords = {homeland security, policy agendas, policy change, subsystems, terrorism},
	pages = {171--194},
	file = {Full Text PDF:C\:\\Users\\emros\\Zotero\\storage\\HAA2P4LK\\May et al. - 2009 - Widespread Policy Disruption Terrorism, Public Ri.pdf:application/pdf;Snapshot:C\:\\Users\\emros\\Zotero\\storage\\LHENSENB\\j.1541-0072.2009.00309.html:text/html},
