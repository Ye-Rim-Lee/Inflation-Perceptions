@article{headworth_power_2020,
	title = {The {Power} of {Second}-{Order} {Legal} {Consciousness}: {Authorities}’ {Perceptions} of “{Street} {Policy}” and {Welfare} {Fraud} {Enforcement}},
	volume = {54},
	copyright = {© 2020 Law and Society Association},
	issn = {1540-5893},
	shorttitle = {The {Power} of {Second}-{Order} {Legal} {Consciousness}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/lasr.12470},
	doi = {10.1111/lasr.12470},
	abstract = {Legal authorities’ second-order legal consciousness—their perceptions of others’ understandings of law—shapes the social realization of legal power. Analysis of interviews with welfare fraud enforcement workers from five US states reveals their perceptions of how clients view law, policy, and enforcement practices, and shows these perceptions’ consequences. Enforcement workers’ perceptions influence the discretionary work of policy implementation, as fraud workers attempt to circumvent what they see as clients’ evasive maneuvers and act in ways they believe will influence clients’ thinking and behavior. Fraud workers’ second-order legal consciousness can also influence welfare law, when their perceptions of clients’ understandings and behaviors drive changes in written rules. Together, these effects demonstrate the power of authorities’ second-order legal consciousness to affect both law in action and law in books. Through documenting the impact of authorities’ second-order legal consciousness, this study fills an important gap in social scientific knowledge of how ongoing, dynamic processes of assessing others’ thinking and responding accordingly shape law-infused environments.},
	language = {en},
	number = {2},
	urldate = {2020-07-20},
	journal = {Law \& Society Review},
	author = {Headworth, Spencer},
	year = {2020},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/lasr.12470},
	pages = {320--353},
	file = {Full Text PDF:C\:\\Users\\emros\\Zotero\\storage\\J6VT5A3S\\Headworth - 2020 - The Power of Second-Order Legal Consciousness Aut.pdf:application/pdf;Snapshot:C\:\\Users\\emros\\Zotero\\storage\\UQNASZZL\\lasr.html:text/html},
}

