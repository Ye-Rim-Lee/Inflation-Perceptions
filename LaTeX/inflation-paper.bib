@article{soss_police_2017,
	title = {Police {Are} {Our} {Government}: {Politics}, {Political} {Science}, and the {Policing} of {Race}–{Class} {Subjugated} {Communities}},
	volume = {20},
	issn = {1094-2939, 1545-1577},
	shorttitle = {Police {Are} {Our} {Government}},
	url = {http://www.annualreviews.org/doi/10.1146/annurev-polisci-060415-093825},
	doi = {10.1146/annurev-polisci-060415-093825},
	abstract = {Against the backdrop of Ferguson and the Black Lives Matter movement, we ask what the American politics subﬁeld has to say about the political lives of communities subjugated by race and class. We argue that mainstream research in this subﬁeld—framed by images of representative democracy and Marshallian citizenship—has provided a rich portrait of what such communities lack in political life. Indeed, by focusing so effectively on their political marginalization, political scientists have ironically made such communities marginal to the subﬁeld’s account of American democracy and citizenship. In this article, we provide a corrective by focusing on what is present in the political lives of such communities. To redress the current imbalance and advance the understandings of race and class in American politics, we argue that studies of the liberal-democratic “ﬁrst face” of the state must be complemented by greater attention to the state’s more controlling “second face.” Focusing on policing, we seek to unsettle the mainstream of a subﬁeld that rarely inquires into governmental practices of social control and the ways “race-class subjugated communities” are governed through coercion, containment, repression, surveillance, regulation, predation, discipline, and violence.},
	language = {en},
	number = {1},
	urldate = {2020-06-05},
	journal = {Annual Review of Political Science},
	author = {Soss, Joe and Weaver, Vesla},
	month = may,
	year = {2017},
	pages = {565--591},
	file = {Soss and Weaver - 2017 - Police Are Our Government Politics, Political Sci.pdf:C\:\\Users\\emros\\Zotero\\storage\\QNRPE96P\\Soss and Weaver - 2017 - Police Are Our Government Politics, Political Sci.pdf:application/pdf},
}

